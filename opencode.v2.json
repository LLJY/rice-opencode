{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "./packages/plugin",
      "options": {
        "trustedWorkspaceWrites": true
      }
    },
    "@mohak34/opencode-notifier@0.5.0"
  ],
  "permissions": [
    {
      "action": "hound_*smart_search",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PAT}"
        },
        "disabled": false
      },
      "deepwiki": {
        "type": "remote",
        "url": "https://mcp.deepwiki.com/mcp",
        "disabled": false
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "disabled": false
      },
      "researcher-mcp": {
        "type": "local",
        "command": ["sh", ".opencode/researcher-mcp.sh"],
        "disabled": true
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp?tools=web_search_exa",
        "oauth": false,
        "headers": {
          "x-api-key": "{file:~/.config/opencode/.exa-api-key}"
        },
        "disabled": false
      },
      "hound": {
        "type": "local",
        "command": ["uvx", "--from", "hound-mcp[all]==12.4.1", "hound"],
        "disabled": false,
        "timeout": {
          "catalog": 120000,
          "execution": 120000
        }
      },
      "ddg-search": {
        "type": "local",
        "command": ["npx", "-y", "@oevortex/ddg_search@1.4.0"],
        "disabled": false
      }
    }
  }
}
