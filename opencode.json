{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "update": "notify",
  "share": "disabled",
  "agents": {
    "general": {
      "model": "openai/gpt-5.6-terra-1m#high"
    },
    "compaction": {
      "model": "openai/gpt-5.6-terra-1m#high"
    },
    "summary": {
      "model": "openai/gpt-5.6-luna-1m#high"
    },
    "title": {
      "model": "openai/gpt-5.6-luna-1m"
    }
  },
  "mcp": {
    "servers": {
      "deepwiki": {
        "type": "remote",
        "url": "https://mcp.deepwiki.com/mcp",
        "disabled": false
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "disabled": false
      },
      "researcher-mcp": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "$HOME/.config/opencode/mcps/researcher-mcp/bin/researcher-mcp"
        ],
        "disabled": false
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp?tools=web_search_exa",
        "oauth": false,
        "headers": {
          "x-api-key": "{env:EXA_API_KEY}"
        },
        "disabled": true
      },
      "gofetch": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "$HOME/.config/opencode/mcps/gofetch-mcp/bin/gofetch"
        ],
        "disabled": false
      },
      "ats-tailor": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "uv run --project $HOME/projects/personal/resume/ats-tailor ats-tailor mcp --repo $HOME/projects/personal/resume"
        ],
        "disabled": false
      },
      "grep_app": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "oauth": false,
        "disabled": false
      }
    }
  },
  "plugins": [
    {
      "package": "./packages/reasoning-router",
      "options": {
        "diagnosticsLimit": 100
      }
    },
    {
      "package": "./packages/quota-fallback",
      "options": {
        "enabled": true,
        "retryDelayMs": 2000,
        "maxSwitchesPerSession": 1,
        "fallbacks": [
          {
            "model": {
              "providerID": "opencode",
              "id": "muse-spark-1.3-contributor-free"
            }
          }
        ]
      }
    },
    {
      "package": "./packages/openai-long-context"
    }
  ],
  "providers": {},
  "model": "openai/gpt-5.6-terra-1m"
}
