{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "carbonfox",
    "mode": "system"
  },
  "diffs": {
    "wrap": "none",
    "view": "auto",
    "tree": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "markdown": "rendered",
    "grouping": "auto",
    "tps": true,
    "terminal": true,
    "image_preview": true,
    "new_location": "launch"
  },
  "animations": true,
  "terminal": {
    "copy": "manual"
  },
  "scroll": {
    "acceleration": false
  },
  "tabs": {
    "enabled": true,
    "layout": "horizontal",
    "indicators": "status"
  }
}
