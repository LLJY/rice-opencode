{
  "name": "rice-opencode",
  "version": "1.0.0",
  "description": "OpenCode config preset and plugin workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/plugin",
    "packages/viz",
    "packages/shared",
    "packages/reasoning-router",
    "packages/quota-fallback",
    "packages/openai-long-context"
  ],
  "scripts": {
    "build": "bun run --cwd packages/plugin build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "pack:check": "bun run --cwd packages/plugin pack:check"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.11",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.0"
  }
}
