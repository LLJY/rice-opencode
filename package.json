{
  "name": "@rice-opencode/plugin",
  "version": "1.0.0",
  "description": "One-stop OpenCode harness with agents, commands, skills, workplan tools, and MCP integrations",
  "type": "module",
  "main": "./src/plugin/index.ts",
  "module": "./src/plugin/index.ts",
  "types": "./src/plugin/index.ts",
  "exports": {
    ".": "./src/plugin/index.ts",
    "./server": "./src/plugin/index.ts"
  },
  "files": [
    "agents",
    "commands",
    "skills",
    "assets",
    "src/plugin",
    "src/custom-tools",
    "README.md",
    "credentials/README.md"
  ],
  "workspaces": [
    "packages/viz",
    "packages/shared"
  ],
  "scripts": {
    "build": "bun build ./src/plugin/index.ts --outdir ./dist --target bun --format esm --external @opencode-ai/plugin",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "pack:check": "bun run scripts/verify-packed.ts",
    "prepack": "bun run build"
  },
  "engines": {
    "opencode": ">=1.18.11"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.14.48"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.0"
  },
  "license": "UNLICENSED"
}
