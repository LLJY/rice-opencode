{
  "name": "rice-opencode",
  "version": "1.0.0",
  "description": "OpenCode V2 plug-and-play preset plugin workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/plugin",
    "packages/viz",
    "packages/shared"
  ],
  "scripts": {
    "build": "bun run --cwd packages/plugin build",
    "test": "bun run build && bun test ./tests ./packages",
    "typecheck": "bun run build && tsc --noEmit",
    "pack:check": "bun run --cwd packages/plugin pack:check",
    "v2:check": "bun run build && bun run ./scripts/check-v2.ts",
    "mcp:check": "bun run build && bun run ./scripts/check-mcp.ts"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.20",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@opencode/core": "2.0.20",
    "@opencode/schema": "2.0.20",
    "@types/bun": "latest",
    "effect": "4.0.0-rc.112",
    "typescript": "^5.3.0"
  }
}
