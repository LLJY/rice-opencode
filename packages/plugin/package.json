{
  "name": "@rice-opencode/plugin",
  "version": "0.1.0",
  "description": "OpenCode V2 plug-and-play tools, skills, agents, and review command",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/index.js",
    "./v2": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run ./scripts/build.ts",
    "test": "bun run build && bun test ./src",
    "typecheck": "bun run build && tsc --noEmit -p ../../tsconfig.json",
    "pack:check": "bun run ./scripts/verify-packed.ts"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "workflow",
    "workplan",
    "agent-skills"
  ],
  "license": "GPL-2.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LLJY/rice-opencode.git",
    "directory": "packages/plugin"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.20",
    "zod": "4.6.5"
  }
}
